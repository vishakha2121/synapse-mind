│
├── backend/            # FastAPI server & AI Brain Modules
│   ├── app/
│   │   ├── api/        # API Endpoints
│   │   ├── brain/      # 5 Modules & Orchestrator
│   │   ├── services/   # Gemini API Client & Prompts
│   │   ├── database/   # SQLite DB Models & CRUD
