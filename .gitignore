│   │   ├── components/ # Brain Visualizer, Chat UI, etc.
│   │   ├── pages/      # Home, Chat
│   │   └── api/        # Axios Client
│   └── package.json
│
├── database/           # SQLite schema & seed files
└── docs/               # Architecture diagrams & documentation
